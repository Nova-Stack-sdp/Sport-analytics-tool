# Required: the app's own PostgreSQL/Neon connection string — the backend
# opens a small pool over it (src/lib/prisma.js). On Neon the pooled string
# ("-pooler" in the host) is the right one here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional but recommended on Neon: used only by the Prisma CLI (migrate,
# generate, introspect), never by the app. Must be the unpooled string — in the
# Neon console open Connect and switch "Connection pooling" off. Migrations are
# DDL in transactions with advisory locks, which Neon's PgBouncer pooler can't
# serve; over the pooled host they fail with "prepared statement ... already
# exists". Without this variable the CLI falls back to DATABASE_URL above.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Required for Teams pages and optional driver/team identity enrichment.
API_SPORTS_KEY=

# Optional: without this, the official Formula 1 YouTube fallback videos are used.
YOUTUBE_API_KEY=

# Required for requireAuth (Firebase ID token verification) and the driver
# image cache (Firestore). Single-line JSON service account key from
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key.
FIREBASE_SERVICE_ACCOUNT=

# Optional: who is an admin, by Firebase UID (comma-separated). Admins see the
# Admin page and are exempt from the email-verification gate below.
# ADMIN_UIDS=

# Email verification — the 6-digit code a user types to prove their address is
# really theirs (POST /api/auth/verify-email/request and /confirm).
# EMAIL_PROVIDER picks the transport:
#   console  (default) — write the mail to the server log. No account, no API
#            key and no network needed; outside production the route also
#            echoes the code back to the client, so the flow can be built,
#            tested and demoed offline.
#   sendgrid — needs SENDGRID_API_KEY. SendGrid's Single Sender Verification is
#            enough — no custom domain required.
#   resend   — needs RESEND_API_KEY and a domain verified in Resend, which
#            (unlike SendGrid's single sender) it requires before delivering
#            to arbitrary recipients.
#   mailersend — needs MAILERSEND_API_KEY; EMAIL_FROM must be on a domain
#            verified in MailerSend (its trial domain works while testing).
# EMAIL_FROM is the sender both HTTP providers mail from; without it the
# built-in "NovaStack-F1 <no-reply@localhost>" default is used.
# EMAIL_CODE_PEPPER is the secret codes are hashed with (HMAC-SHA256).
# Required in production: without it the server refuses to start, and refuses
# to hash or check codes. Local dev and tests use a built-in development
# default, where codes are printed to the log anyway.
# EMAIL_PROVIDER=console
# EMAIL_FROM="NovaStack-F1 <no-reply@yourdomain.com>"
# EMAIL_CODE_PEPPER=
# SENDGRID_API_KEY=
# RESEND_API_KEY=
# MAILERSEND_API_KEY=

# Local development defaults.
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000

# Optional: rate limits (requests per minute, per client IP) and how long
# repeated public reads are served from memory. 0 switches one off.
# RATE_LIMIT_PER_MINUTE=1200          # whole site API
# RATE_LIMIT_V1_PER_MINUTE=120        # public /api/v1
# RATE_LIMIT_EXPORTS_PER_MINUTE=10    # /api/v1/exports
# RATE_LIMIT_SIGNUP_PER_MINUTE=10     # /api/auth/signup (mails codes)
# RATE_LIMIT_SESSION_PER_MINUTE=20    # POST /api/auth/session (token exchange)
# CACHE_TTL_SECONDS=60

# Optional: BBC/ESPN news refresh frequency and number of newest shared
# headlines persisted in Firestore. The page displays 10 at a time.
# F1_NEWS_POLL_MS=600000
# F1_NEWS_PERSISTED_ITEMS=30

# Rejected code submissions are deleted after review retention expires.
# Apply migrations before enabling this in a deployed backend.
# REJECTED_CODE_CLEANUP_ENABLED=true
# REJECTED_CODE_RETENTION_DAYS=7
# REJECTED_CODE_CLEANUP_INTERVAL_MS=3600000
# REJECTED_CODE_CLEANUP_BATCH_SIZE=100
