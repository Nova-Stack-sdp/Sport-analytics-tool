# Required: PostgreSQL/Neon connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Required for Teams pages and optional driver/team identity enrichment.
API_SPORTS_KEY=

# Optional: without this, the official Formula 1 YouTube fallback videos are used.
YOUTUBE_API_KEY=

# Local development defaults.
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
