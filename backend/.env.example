# Required: PostgreSQL/Neon connection string used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Required for Teams pages and optional driver/team identity enrichment.
API_SPORTS_KEY=

# Optional: without this, the official Formula 1 YouTube fallback videos are used.
YOUTUBE_API_KEY=

# Required for requireAuth (Firebase ID token verification) and the driver
# image cache (Firestore). Single-line JSON service account key from
# Firebase Console -> Project settings -> Service accounts -> Generate new
# private key.
FIREBASE_SERVICE_ACCOUNT=

# Who can see and use the Admin page: comma-separated Firebase UIDs, no
# spaces needed. Find a user's UID on their Profile page ("User ID") or in
# Firebase Console -> Authentication -> Users. Leave empty for no admins.
ADMIN_UIDS=

# Local development defaults.
PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
