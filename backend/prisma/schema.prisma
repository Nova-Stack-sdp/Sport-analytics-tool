// ============================================================
// F1 Sport Analytics Platform — Prisma schema
// Event-sourced: dimension tables -> event log (source of truth) -> projections (derived, rebuildable)
// ============================================================

generator client {
  provider        = "prisma-client-js"
  // Loads `include`d relations in the same SQL query (JOINs) instead of one
  // query per relation level. Each query is a network round trip to Neon,
  // so this cuts most API responses from 2-3 round trips to 1. Responses
  // were checked to be byte-for-byte identical — see docs/PERFORMANCE.md.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------------
// 1. Dimension tables (reference data)
// ------------------------------------------------------------

model Circuit {
  id        String    @id @default(uuid()) @map("circuit_id")
  // OpenF1's circuit_key — lets the sync job upsert instead of duplicating rows
  openf1Key Int?      @unique @map("openf1_key")
  name      String
  country   String
  location  String
  meetings  Meeting[]

  @@map("circuit")
}

model Meeting {
  id        String    @id @default(uuid()) @map("meeting_id")
  // OpenF1's meeting_key
  openf1Key Int?      @unique @map("openf1_key")
  season    Int
  name      String
  circuitId String    @map("circuit_id")
  circuit   Circuit   @relation(fields: [circuitId], references: [id])
  startDate DateTime  @map("start_date") @db.Date
  sessions  Session[]

  @@index([season])
  @@index([circuitId])
  @@map("meeting")
}

enum SessionType {
  FP1
  FP2
  FP3
  Q
  Sprint
  Race
}

enum SessionStatus {
  scheduled
  live
  finished
}

model Session {
  id          String        @id @default(uuid()) @map("session_id")
  // OpenF1's session_key
  openf1Key   Int?          @unique @map("openf1_key")
  meetingId   String        @map("meeting_id")
  meeting     Meeting       @relation(fields: [meetingId], references: [id])
  type        SessionType
  startTime   DateTime      @map("start_time")
  endTime     DateTime?     @map("end_time")
  status      SessionStatus @default(scheduled)

  entries     Entry[]
  submissions Submission[]
  events      Event[]

  @@index([meetingId])
  @@index([type])
  @@map("session")
}

model Team {
  id      String        @id @default(uuid()) @map("team_id")
  name    String
  season  Int
  entries Entry[]
  seasonStats TeamSeasonStats[]
  follows Follow[]

  @@unique([name, season])
  @@map("team")
}

model Driver {
  id           String   @id @default(uuid()) @map("driver_id")
  name         String
  // OpenF1 treats this as the persistent driver identifier — unique so sync can upsert by it
  driverNumber Int      @unique @map("driver_number")
  entries      Entry[]
  careerStats  DriverCareerStats[]
  image        DriverImage?
  follows      Follow[]

  @@map("driver")
}

// Photo uploaded by a user for a driver. Kept in its own table (not a column on
// driver) so queries that load drivers never drag image bytes along with them.
model DriverImage {
  driverId    String   @id @map("driver_id")
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  data        Bytes
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  // Firebase uid of whoever uploaded it
  uploadedBy  String?  @map("uploaded_by")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("driver_image")
}

// A signed-in user following a driver or a team. Exactly one of driver_id /
// team_id is set per row. `snapshot` holds the small display info the
// Following list needs (name, number, colours...) so it renders in one query.
model Follow {
  id        String   @id @default(uuid()) @map("follow_id")
  // Firebase uid
  userId    String   @map("user_id")
  driverId  String?  @map("driver_id")
  driver    Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  teamId    String?  @map("team_id")
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  snapshot  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, driverId])
  @@unique([userId, teamId])
  @@index([userId])
  @@map("follow")
}

model Entry {
  id        String  @id @default(uuid()) @map("entry_id")
  sessionId String  @map("session_id")
  session   Session @relation(fields: [sessionId], references: [id])
  driverId  String  @map("driver_id")
  driver    Driver  @relation(fields: [driverId], references: [id])
  teamId    String  @map("team_id")
  team      Team    @relation(fields: [teamId], references: [id])

  events      Event[]
  sessionStats DriverSessionStats?

  @@unique([sessionId, driverId])
  @@index([teamId])
  @@map("entry")
}

// ------------------------------------------------------------
// 2. Event log (append-only, source of truth)
// ------------------------------------------------------------

enum SubmissionSource {
  openf1_sync
  manual_upload
}

enum SubmissionStatus {
  pending
  accepted
  rejected
  partially_accepted
}

// Why a dataset was submitted. race_data is race data meant for the platform:
// its events go into the event log and count once an admin accepts it.
// code_test is sample data a developer sends so an admin can test their code:
// it is validated and stored as uploaded, but never written to the event log.
enum SubmissionPurpose {
  race_data
  code_test
}

model Submission {
  id               String           @id @default(uuid()) @map("submission_id")
  source           SubmissionSource
  // References an auth-system user ID, not a local FK — no User model in this schema.
  // Null for automated OpenF1 sync submissions.
  submitterId      String?          @map("submitter_id")
  sessionId        String           @map("session_id")
  session          Session          @relation(fields: [sessionId], references: [id])
  fileRef          String?          @map("file_ref")
  status           SubmissionStatus @default(pending)
  validationErrors Json?            @map("validation_errors")
  // What the submission did: { inserted, corrected, unchanged,
  // duplicatesInBatch, rejected } — see src/ingestion/planIngestion.js.
  summary          Json?
  submittedAt      DateTime         @default(now()) @map("submitted_at")
  // References an auth-system user ID (admin who reviewed), not a local FK.
  reviewedBy       String?          @map("reviewed_by")
  reviewedAt       DateTime?        @map("reviewed_at")
  purpose          SubmissionPurpose @default(race_data)
  // Soft delete: an admin can delete a dataset, which hides it and its events
  // everywhere (statistics, public API, replay) but keeps the rows so it can
  // be restored. Both are null while the dataset is live.
  deletedAt        DateTime?        @map("deleted_at")
  // References an auth-system user ID (the admin who deleted it).
  deletedBy        String?          @map("deleted_by")

  events Event[]
  upload SubmissionUpload?

  @@index([sessionId])
  @@index([status])
  @@index([purpose, deletedAt, submittedAt])
  @@map("submission")
}

// The dataset exactly as it was uploaded, byte for byte, so an admin can
// download what the developer sent. Kept in its own table (like driver_image)
// so queries that list submissions never pull megabytes of upload along.
// Submissions made before this table existed have no row here.
model SubmissionUpload {
  submissionId String     @id @map("submission_id")
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  data         Bytes
  contentType  String     @map("content_type")
  sizeBytes    Int        @map("size_bytes")
  // Hex SHA-256 of data, so a download can be checked against what arrived.
  sha256       String
  createdAt    DateTime   @default(now()) @map("created_at")

  @@map("submission_upload")
}

enum EventType {
  lap_completed
  pit_stop
  tyre_stint
  position_change
  flag_event
  race_control_message
  weather_snapshot
  session_status_change
  classification
  grid_position
}

model Event {
  id        String    @id @default(uuid()) @map("event_id")
  sessionId String    @map("session_id")
  session   Session   @relation(fields: [sessionId], references: [id])
  // Null for session-wide events (flags, weather, session status).
  entryId   String?   @map("entry_id")
  entry     Entry?    @relation(fields: [entryId], references: [id])
  eventType EventType @map("event_type")
  lapNumber Int?      @map("lap_number")
  occurredAt DateTime @map("occurred_at")
  // Shape depends on eventType — see EVENT TYPES table in project docs.
  payload   Json

  sourceSubmissionId String     @map("source_submission_id")
  sourceSubmission   Submission @relation(fields: [sourceSubmissionId], references: [id])

  // Self-referencing correction chain: this event, if superseded, points forward
  // to the event that replaces it. The original row is never deleted or edited.
  supersededById String? @unique @map("superseded_by")
  supersededBy   Event?  @relation("EventSupersession", fields: [supersededById], references: [id])
  supersedes     Event?  @relation("EventSupersession")

  ingestedAt DateTime @default(now()) @map("ingested_at")

  @@index([sessionId, eventType])
  @@index([entryId])
  @@index([sourceSubmissionId])
  @@index([sessionId, lapNumber])
  // The v1 API's cursor order — see migration 20261001090000_add_event_time_indexes.
  @@index([occurredAt, id])
  @@index([sessionId, occurredAt, id])
  @@map("event")
}

// ------------------------------------------------------------
// 3. Projection tables (computed, rebuildable — NOT source of truth)
// ------------------------------------------------------------

model DriverSessionStats {
  entryId         String  @id @map("entry_id")
  entry           Entry   @relation(fields: [entryId], references: [id])
  fastestLapMs    Int?    @map("fastest_lap_ms")
  avgLapMs        Float?  @map("avg_lap_ms")
  totalPitTimeMs  Int?    @map("total_pit_time_ms")
  positionsGained Int?    @map("positions_gained")
  finalPosition   Int?    @map("final_position")
  points          Float?

  @@map("driver_session_stats")
}

model DriverCareerStats {
  driverId String @map("driver_id")
  driver   Driver @relation(fields: [driverId], references: [id])
  season   Int
  wins     Int    @default(0)
  podiums  Int    @default(0)
  points   Float  @default(0)
  dnfCount Int    @default(0) @map("dnf_count")

  @@id([driverId, season])
  @@map("driver_career_stats")
}

model TeamSeasonStats {
  teamId          String @map("team_id")
  team            Team   @relation(fields: [teamId], references: [id])
  season          Int
  points          Float  @default(0)
  wins            Int    @default(0)
  reliabilityRate Float? @map("reliability_rate")

  @@id([teamId, season])
  @@map("team_season_stats")
}

enum SubjectType {
  driver
  team
}

model HeadToHead {
  id          String      @id @default(uuid())
  // Polymorphic: refers to driver_id or team_id depending on subjectType.
  // Not a real FK — can't be, since it points at two different tables.
  subjectAId  String      @map("subject_a_id")
  subjectBId  String      @map("subject_b_id")
  subjectType SubjectType @map("subject_type")
  winsA       Int         @default(0) @map("wins_a")
  winsB       Int         @default(0) @map("wins_b")
  sampleSize  Int         @default(0) @map("sample_size")

  @@unique([subjectAId, subjectBId, subjectType])
  @@map("head_to_head")
}

// ------------------------------------------------------------
// 4. Infrastructure — not race data, just a generic durable cache for
//    expensive external API responses that don't change once fetched
//    (e.g. a completed session's OpenF1 bundle). Exists so a server
//    restart/redeploy doesn't force a multi-minute re-fetch from a
//    rate-limited third-party API. Deliberately generic (string key +
//    JSON payload) rather than named after one specific use case.
// ------------------------------------------------------------
model ExternalApiCache {
  key       String   @id
  payload   Json
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@map("external_api_cache")
}


// ------------------------------------------------------------
// 5. User Features (External Auth Linked)
// ------------------------------------------------------------

model UserProfile {
  // This is the Firebase UID, NOT an auto-generated UUID
  userId         String   @id @map("user_id") 
  favoriteTeamId String?  @map("favorite_team_id")
  favoriteDriverId String? @map("favorite_driver_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("user_profile")
}

enum NotificationType {
  race_reminder
  driver_news
  team_update
  system_alert
}

model Notification {
  id        String           @id @default(uuid()) @map("notification_id")
  // References an auth-system user ID (e.g., Firebase UID), not a local FK.
  userId    String           @map("user_id")
  type      NotificationType
  title     String?
  message   String
  linkUrl   String?          @map("link_url")
  // Stable source event, independent of changing headlines or reminder text.
  eventKey  String?          @map("event_key")
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  // Index by userId for fast queries when a user loads their profile
  @@index([userId, createdAt])
  @@index([isRead])
  
  // Enforces exactly one notification per user per article title
  @@unique([userId, message])
  @@unique([userId, eventKey])
  
  @@map("notification")
}


// ------------------------------------------------------------
// 6. Code submissions (developer scripts awaiting admin review)
// ------------------------------------------------------------

enum CodeSubmissionStatus {
  pending
  approved
  rejected
}

model CodeSubmission {
  id             String               @id @default(uuid()) @map("code_submission_id")
  submitterId    String               @map("submitter_id")
  submitterEmail String?              @map("submitter_email")
  title          String
  language       String
  code           String
  description    String?
  tags           String[]             @default([])
  status         CodeSubmissionStatus @default(pending)
  submittedAt    DateTime             @default(now()) @map("submitted_at")
  reviewedBy     String?              @map("reviewed_by")
  reviewedAt     DateTime?            @map("reviewed_at")

  @@index([status, submittedAt])
  @@index([status, reviewedAt])
  @@index([submitterId])
  @@map("code_submission")
}

// Approved code lives here. sourceSubmissionId is the ID the submission had
// in code_submission; it is a plain column, not a foreign key, so the
// original row can be removed once its code has been approved.
model VerifiedCode {
  id                 String   @id @default(uuid()) @map("verified_code_id")
  sourceSubmissionId String   @unique @map("source_submission_id")
  title              String
  // Public address of the script: /api/v1/code/<slug>. Filled in by the
  // database on insert (trigger verified_code_assign_slug, see migration
  // 20261009120000_add_verified_code_slug) from the title, e.g.
  // "Average pit loss" -> average-pit-loss, with -2, -3... on clashes.
  // Never changes afterwards, so links keep working.
  slug               String   @unique @default("")
  language           String
  code               String
  description        String?
  tags               String[] @default([])
  submitterId        String   @map("submitter_id")
  // Carried over from the submission so its history survives once the
  // code_submission row is gone.
  submitterEmail     String?  @map("submitter_email")
  submittedAt        DateTime @default(now()) @map("submitted_at")
  verifiedBy         String   @map("verified_by")
  verifiedAt         DateTime @default(now()) @map("verified_at")

  @@index([submitterId, verifiedAt])
  @@map("verified_code")
}

// ------------------------------------------------------------
// 7. Email verification codes
// ------------------------------------------------------------
// A 6-digit code mailed to the account, proving the address is real and
// reachable. One row per send; the newest unconsumed row is the live code.
//
// codeHash is an HMAC-SHA256 of the code, never the code itself. A 6-digit
// space has only a million possibilities, so hashing cannot make it
// unguessable — that is what the 10-minute expiry and the attempt cap do.
// The hash exists so a database dump alone does not hand over live codes.

model EmailVerificationCode {
  id         String    @id @default(uuid()) @map("code_id")
  // References an auth-system user ID (e.g., Firebase UID), not a local FK.
  userId     String    @map("user_id")
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  // Set when the code is used, replaced by a newer one, or burned after
  // too many wrong guesses. Only unconsumed rows can still verify.
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  // Every read is "the newest live code for this user" and the cooldown /
  // daily-cap checks count rows created since a timestamp.
  @@index([userId, createdAt])
  @@map("email_verification_code")
}

// ------------------------------------------------------------
// 8. Pending sign-ups
// ------------------------------------------------------------
// A sign-up request awaiting its emailed code. Deliberately NOT a user:
// the Firebase account is created by the backend only when the code is
// confirmed (see src/routes/signup.js), so no account — and no profile —
// exists for an address that has not proved itself. Keyed by email alone
// (there is no uid yet); same code mechanics as EmailVerificationCode.

model PendingSignup {
  id         String    @id @default(uuid()) @map("signup_id")
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  // Set when the code is used, replaced by a newer one, or burned after
  // too many wrong guesses. Only unconsumed rows can still confirm.
  consumedAt DateTime? @map("consumed_at")
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")

  // Every read is "the newest live code for this email" and the cooldown /
  // daily-cap checks count rows created since a timestamp.
  @@index([email, createdAt])
  @@map("pending_signup")
}
